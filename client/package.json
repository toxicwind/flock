{
  "name": "nim-client",
  "version": "1.0.0",
  "description": "Unified TypeScript/JavaScript SDK for all 77 NVIDIA NIM free endpoints — chat, vision, speech, embeddings, biology, safety, and more.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nvidia",
    "nim",
    "llm",
    "ai",
    "sdk",
    "nemotron",
    "llama",
    "embeddings",
    "vision",
    "speech",
    "biology",
    "drug-discovery"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
