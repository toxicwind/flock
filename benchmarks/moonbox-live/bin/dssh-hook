#!/bin/bash
# dssh-hook - Modular hook manager
HOOKS_DIR="/mnt/agents/output/hooks.d"
ACTION=$1
HOOK_NAME=$2

case "$ACTION" in
    enable)
        ln -sf "$HOOKS_DIR/available/$HOOK_NAME.sh" "$HOOKS_DIR/enabled/$HOOK_NAME.sh"
        echo "Enabled: $HOOK_NAME"
        ;;
    disable)
        rm -f "$HOOKS_DIR/enabled/$HOOK_NAME.sh"
        echo "Disabled: $HOOK_NAME"
        ;;
    list)
        echo "Available:"
        ls "$HOOKS_DIR/available/"*.sh 2>/dev/null | xargs -n1 basename
        echo "Enabled:"
        ls "$HOOKS_DIR/enabled/"*.sh 2>/dev/null | xargs -n1 basename
        ;;
    reload)
        source /mnt/agents/output/.dsshrc
        echo "Reloaded"
        ;;
    *)
        echo "Usage: dssh-hook {enable|disable|list|reload} [hook_name]"
        ;;
esac
