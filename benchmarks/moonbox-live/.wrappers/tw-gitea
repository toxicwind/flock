#!/usr/bin/env python3
"""Gitea setup helper."""
import sys, subprocess, os

def setup():
    print("=== GITEA SETUP ===")
    print("1. Get a VPS (Hetzner CX11: €3.79/mo, or Vultr: $5/mo)")
    print("2. Install Docker: curl -fsSL https://get.docker.com | sh")
    print("3. Copy gitea-docker-compose.yml to VPS")
    print("4. Run: docker compose up -d")
    print("5. Access: https://your-vps-ip:3000")
    print("6. First user = admin")
    print("7. Add SSH key, create repos, mirror from GitHub")
    print("")
    print("For unlimited CI:")
    print("  docker exec -u git gitea gitea actions generate-runner-token")
    print("  Then register self-hosted runner")

def mirror():
    GITHUB_PAT = os.environ.get("GITHUB_PAT", "")
    GITEA_URL = os.environ.get("GITEA_URL", "https://your-gitea-instance")
    GITEA_TOKEN = os.environ.get("GITEA_TOKEN", "")
    
    repos = ["toxicwind-repos", "bashagt", "github-advanced-search-mcp"]
    for repo in repos:
        print(f"Mirroring {repo}...")
        subprocess.run([
            "curl", "-s", "-X", "POST",
            "-H", f"Authorization: token {GITEA_TOKEN}",
            "-H", "Content-Type: application/json",
            "-d", f"{{\"clone_addr\":\"https://github.com/toxicwind/{repo}.git\",\"repo_name\":\"{repo}\",\"mirror\":true}}",
            f"{GITEA_URL}/api/v1/repos/migrate"
        ], capture_output=True)

if __name__ == "__main__":
    if len(sys.argv) < 2:
        setup()
    elif sys.argv[1] == "mirror":
        mirror()
