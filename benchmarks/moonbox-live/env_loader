#!/bin/sh
# env_loader — dynamic environment loader for moonbox
# Extracts env from portal, s6, kernel, and system

export T=$(date -u +%s)
export RID=$(cat /mnt/agents/dot/var/RID 2>/dev/null || echo "UNKNOWN")
export CID=$(hostname)
export SID=${AGENT_RUNTIME_SANDBOX_ID:-unknown}

# Portal env
export PORTAL_MOUNT=${KIMI_PROJECT_PORTAL_CAPABILITY_MOUNT:-/mnt/portal-overlay}
export PORTAL_ADDR=${KIMI_PROJECT_PORTAL_CAPABILITY_PROD_ADDR:-https://kimi-api-sandbox.msh.team/apiv2}
export PORTAL_ENV=${KIMI_PROJECT_PORTAL_CAPABILITY_ENV:-prod}

# Network
export HTTP_PROXY=${HTTP_PROXY:-http://10.86.13.73:5900}
export HTTPS_PROXY=${HTTPS_PROXY:-http://10.86.13.73:5900}
export ALL_PROXY=${ALL_PROXY:-http://10.86.13.73:5900}
export NO_PROXY=${NO_PROXY:-localhost,127.0.0.1}

# Mirrors
export PIP_INDEX_URL=${PIP_INDEX_URL:-https://mirrors.aliyun.com/pypi/simple}
export GOPROXY=${GOPROXY:-https://goproxy.cn}
export NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}

# Git
export GH_PAT=${GH_PAT:-${MOONBOX_PAT:-}}
export GITHUB_USER=${GITHUB_USER:-toxicwind}

# Identity
export MOONBOX_RID=$RID
export MOONBOX_CID=$CID
export MOONBOX_SID=$SID
export MOONBOX_TIER=2

# Load from portal if available
if [ -f "$PORTAL_MOUNT/.agent-gw.json" ]; then
    export PORTAL_KEY=$(cat "$PORTAL_MOUNT/.agent-gw.json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('api_key',''))" 2>/dev/null)
    export PORTAL_BASE=$(cat "$PORTAL_MOUNT/.agent-gw.json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('base_url',''))" 2>/dev/null)
fi

# Load from s6 if available
for f in /etc/s6/s6-svscan/env/*; do
    [ -f "$f" ] && export $(basename "$f")=$(cat "$f")
done

# Load from kernel if available
for f in /tmp/tmp*.json; do
    [ -f "$f" ] && export KERNEL_CONN="$f"
done

echo "[$T] ENV_LOADED rid=$RID cid=$CID sid=$SID tier=2"
