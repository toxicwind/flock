# TEST 1: Background Process Escape
# Simulate a long-running command that would exceed tool budget

echo "Starting background process escape test..."

# Create a pending task
cat > /mnt/agents/.chat/pending/test_strace.task << 'TASK'
agent_id: db-bypass-agent
command:
  echo "=== PORTAL NETWORK TRACE ===" > /mnt/agents/output/bg_escape_test.log
  date >> /mnt/agents/output/bg_escape_test.log
  netstat -tlnp >> /mnt/agents/output/bg_escape_test.log 2>&1
  echo "=== PORTAL PROCESS ===" >> /mnt/agents/output/bg_escape_test.log
  ps aux | grep portal >> /mnt/agents/output/bg_escape_test.log
  echo "=== DONE ===" >> /mnt/agents/output/bg_escape_test.log
  echo "COMPLETE" > /mnt/agents/output/bg_escape_test.done
TASK

# Trigger limit-exhausted hook
bash /mnt/agents/.chat/hooks/on_limit_exhausted.sh

echo "Background task spawned"
ls -la /mnt/agents/.chat/active/
sleep 2

# Check if it completed
echo ""
echo "=== BACKGROUND RESULT ==="
[ -f /mnt/agents/output/bg_escape_test.done ] && echo "DONE" || echo "RUNNING"
cat /mnt/agents/output/bg_escape_test.log 2>/dev/null | head -20 || echo "(not ready)"

echo ""
echo "=== TEST 2: Kernel Env Override ==="
# Check if kernel_server reads env vars we can override
cat /proc/$(pgrep -f kernel_server)/environ 2>/dev/null | tr '\0' '\n' | grep -iE "budget|limit|turn|max" | head -10 || echo "No env vars found in kernel_server"

# Try writing to a file that kernel might check
mkdir -p /mnt/agents/.kernel_override
echo "999" > /mnt/agents/.kernel_override/tool_budget
echo "999" > /mnt/agents/.kernel_override/max_turns
echo "Kernel override files written"
ls -la /mnt/agents/.kernel_override/
