#!/usr/bin/env bash
set -euo pipefail
PAT=${GITHUB_PAT:?"GITHUB_PAT must be exported"}
REPO="toxicwind/portal-audit"
for dir in /mnt/agents/*; do
  [ -d "$dir" ] || continue
  name=$(basename "$dir")
  [ "$name" = "dot" ] && continue
  export GIT_DIR="$dir/_git" GIT_WORK_TREE="$dir"
  git add -A 2>/dev/null || true
  git commit -m "auto: $name $(date +%s)" 2>/dev/null || true
  git push "https://${PAT}@github.com/${REPO}.git" "main:${name}" 2>/dev/null || true
  echo "pushed: $name"
done
