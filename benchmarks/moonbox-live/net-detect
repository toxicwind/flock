#!/usr/bin/env bash
set -euo pipefail
url="$1"
shift
timeout="${TIMEOUT:-3}"
if [[ "$url" == wss://* ]] || [[ "$url" == ws://* ]]; then
  echo "WSS detected"
  python3 -c "import websocket; ws=websocket.create_connection('${url#*://}', timeout=$timeout); ws.send('ping'); print(ws.recv()); ws.close()" 2>/dev/null || echo "WSS_FAIL"
elif [[ "$url" == grpc://* ]] || [[ "$url" == *":50051"* ]]; then
  echo "GRPC detected"
  python3 -c "import grpc; print('grpc ok')" 2>/dev/null || echo "GRPC_FAIL"
else
  echo "HTTP detected"
  curl -s -o /dev/null -w "%{http_code}" --connect-timeout "$timeout" "$url" 2>/dev/null || echo "HTTP_FAIL"
fi
