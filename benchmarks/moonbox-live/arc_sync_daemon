#!/bin/bash
# arc_sync_daemon - background sync for all assigned dirs
# Runs every 60s, pushes changes automatically

DIRS="/mnt/agents/dot /mnt/agents/ProtoDeep /mnt/agents/claude-forge /mnt/agents/recon /mnt/agents/skills-custom /mnt/agents/deploy"
LOG="/mnt/agents/dot/log/sync_daemon.log"

while true; do
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] SYNC_CYCLE_START" >> "$LOG"
    for dir in $DIRS; do
        if [ -d "$dir" ]; then
            timeout 15 /mnt/agents/dot/bin/arc_git "$dir" sync "auto_$(date +%s)" >> "$LOG" 2>&1
        fi
    done
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] SYNC_CYCLE_DONE" >> "$LOG"
    sleep 60
done
