#!/usr/local/bin/python3.12
# git_fix — FUSE-safe git repair using system Python
# No tmp, no bare repos, no manual steps

import os, sys, json, time, pathlib, subprocess, shutil

DOT = pathlib.Path("/mnt/agents/dot")
PAT = os.environ.get("GH_PAT") or os.environ.get("MOONBOX_PAT") or ""

def log(msg):
    ts = time.strftime("%Y%m%d_%H%M%S", time.gmtime())
    print(f"[{ts}] {msg}", flush=True)

def fix_git_dir(work_tree):
    wt = pathlib.Path(work_tree)
    gd = wt / "_git"
    
    log(f"FIX_START: {wt.name}")
    
    # Remove stale lock files
    for lock in gd.glob("*.lock"):
        try:
            lock.unlink()
            log(f"REMOVED_LOCK: {lock.name}")
        except:
            pass
    
    # Ensure basic structure
    for sub in ["objects/info", "objects/pack", "refs/heads", "refs/tags", "hooks", "info"]:
        (gd / sub).mkdir(parents=True, exist_ok=True)
    
    # HEAD
    head_file = gd / "HEAD"
    try:
        head_file.write_text("ref: refs/heads/main\n")
        os.chmod(head_file, 0o666)
        log("HEAD_OK")
    except Exception as e:
        log(f"HEAD_ERR: {e}")
    
    # Config
    config_file = gd / "config"
    config_text = """[core]
    repositoryformatversion = 0
    filemode = true
    bare = false
    logallrefupdates = true
[init]
    defaultBranch = main
"""
    try:
        config_file.write_text(config_text)
        os.chmod(config_file, 0o666)
        log("CONFIG_OK")
    except Exception as e:
        log(f"CONFIG_ERR: {e}")
    
    # description
    try:
        (gd / "description").write_text(f"moonbox repo for {wt.name}\n")
    except:
        pass
    
    # .gitfile marker
    try:
        (wt / ".gitfile").write_text("gitdir: _git\n")
    except:
        pass
    
    log(f"FIX_DONE: {wt.name}")
    return True

def git_cmd(work_tree, *args):
    wt = pathlib.Path(work_tree)
    gd = wt / "_git"
    env = {
        **os.environ,
        "GIT_DIR": str(gd),
        "GIT_WORK_TREE": str(wt),
        "GIT_AUTHOR_NAME": f"fyksdwD-{os.uname().nodename[:8]}",
        "GIT_AUTHOR_EMAIL": f"fyksdwD@{os.uname().nodename}.local",
        "GIT_COMMITTER_NAME": f"fyksdwD-{os.uname().nodename[:8]}",
        "GIT_COMMITTER_EMAIL": f"fyksdwD@{os.uname().nodename}.local",
        "GIT_ASKPASS": "/bin/false",
        "GIT_TERMINAL_PROMPT": "0",
    }
    cmd = ["git"] + list(args)
    r = subprocess.run(cmd, env=env, capture_output=True, text=True)
    if r.returncode != 0 and r.stderr:
        log(f"GIT_ERR: {' '.join(args)}: {r.stderr[:100]}")
    return r.returncode == 0, r.stdout, r.stderr

def ensure_remote(work_tree):
    wt = pathlib.Path(work_tree)
    repo_name = f"moonbox-{wt.name}-{time.strftime('%Y%m%d')}"
    
    ok, out, err = git_cmd(wt, "remote", "get-url", "origin")
    if ok:
        log(f"REMOTE_EXISTS: {wt.name}")
        return True
    
    # Create GitHub repo
    log(f"REMOTE_CREATE: {repo_name}")
    headers = {"Authorization": f"token {PAT}", "Accept": "application/vnd.github.v3+json"}
    data = json.dumps({"name": repo_name, "private": True, "auto_init": False})
    
    r = subprocess.run(
        ["curl", "-s", "-m10", "-H", f"Authorization: token {PAT}",
         "-H", "Accept: application/vnd.github.v3+json",
         "-d", data, "https://api.github.com/user/repos"],
        capture_output=True, text=True
    )
    
    if r.returncode == 0 and '"id"' in r.stdout:
        log(f"REMOTE_CREATED: {repo_name}")
    else:
        log(f"REMOTE_CREATE_WARN: {r.stderr[:100] if r.stderr else 'unknown'}")
    
    remote_url = f"https://toxicwind:{PAT}@github.com/toxicwind/{repo_name}.git"
    git_cmd(wt, "remote", "add", "origin", remote_url)
    return True

def autopush(work_tree, message=""):
    wt = pathlib.Path(work_tree)
    if not message:
        message = f"autopush:{int(time.time())}:{wt.name}"
    
    log(f"AUTOPUSH: {wt.name}")
    fix_git_dir(wt)
    ensure_remote(wt)
    
    git_cmd(wt, "add", "-A")
    ok, out, err = git_cmd(wt, "commit", "-m", message, "--quiet")
    
    ok, out, err = git_cmd(wt, "push", "origin", "main", "--force", "--quiet")
    if ok:
        log(f"AUTOPUSH_OK: {wt.name}")
        return True
    else:
        log(f"AUTOPUSH_FAIL: {wt.name}: {err[:100] if err else 'unknown'}")
        return False

def main():
    if len(sys.argv) < 2:
        print("Usage: git_fix <fix|autopush|autopush-all> [dir] [message]")
        sys.exit(1)
    
    cmd = sys.argv[1]
    
    if cmd == "fix":
        target = sys.argv[2] if len(sys.argv) > 2 else "/mnt/agents/dot"
        fix_git_dir(target)
    elif cmd == "autopush":
        target = sys.argv[2] if len(sys.argv) > 2 else "/mnt/agents/dot"
        msg = sys.argv[3] if len(sys.argv) > 3 else ""
        autopush(target, msg)
    elif cmd == "autopush-all":
        for d in pathlib.Path("/mnt/agents").iterdir():
            if d.is_dir():
                autopush(d)
    else:
        target = sys.argv[2] if len(sys.argv) > 2 else "/mnt/agents/dot"
        git_cmd(target, *sys.argv[1:])

if __name__ == "__main__":
    main()
