#!/usr/bin/env bash
set -euo pipefail
PAT=${GITHUB_PAT:?"GITHUB_PAT must be exported"}
REPO="toxicwind/portal-audit"
export GIT_DIR="${1:-/mnt/agents/dot/_git}"
export GIT_WORK_TREE="${2:-/mnt/agents/dot}"
shift 2 || true
if [ "$1" = "push" ] || [ "$1" = "pull" ]; then
  git "$@" "https://${PAT}@github.com/${REPO}.git" main
else
  git "$@"
fi
