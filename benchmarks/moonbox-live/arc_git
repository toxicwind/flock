#!/bin/bash
# arc_git v2 - Atomic git wrapper for FUSE persistence
# Git metadata in /root/.git_fuse/*.git (local fs)
# Worktree in /mnt/agents/* (FUSE)

set -e

PAT=${GITHUB_PAT:?"GITHUB_PAT must be exported"}
REPO="toxicwind/_git"
REMOTE="https://toxicwind:${PAT}@github.com/${REPO}.git"

wt="${1:-/mnt/agents}"
name=$(basename "$wt" | sed 's/[^a-zA-Z0-9]/-/g')
gd="/root/.git_fuse/${name}.git"

# Ensure git dir exists
if [ ! -f "$gd/HEAD" ]; then
    mkdir -p "$gd"
    git init --bare "$gd" >/dev/null 2>&1
    git --git-dir="$gd" config user.email "toxicwind@users.noreply.github.com"
    git --git-dir="$gd" config user.name "toxicwind"
    git --git-dir="$gd" remote add origin "$REMOTE" 2>/dev/null || true
fi

export GIT_DIR="$gd"
export GIT_WORK_TREE="$wt"

case "${2:-sync}" in
    init) echo "INIT: $wt -> $gd" ;;
    add) cd "$wt" && git add -A ;;
    commit)
        msg="${3:-"arc $(date -u +%Y-%m-%dT%H:%M:%SZ)"}"
        cd "$wt" && git commit -m "$msg" || echo "NO_CHANGES"
        ;;
    push)
        branch="${3:-arc-${name}-$(date +%s)}"
        cd "$wt" && git branch -M "$branch" && git push -u origin "$branch" --force
        ;;
    sync)
        msg="${3:-"arc-sync $(date -u +%Y-%m-%dT%H:%M:%SZ)"}"
        branch="arc-${name}-$(date +%s)"
        cd "$wt"
        git add -A
        if git diff --cached --quiet; then
            echo "NO_CHANGES"
            exit 0
        fi
        git commit -m "$msg"
        git branch -M "$branch"
        git push -u origin "$branch" --force
        ;;
    status) cd "$wt" && git status --short ;;
    log) cd "$wt" && git log --oneline -5 ;;
esac
