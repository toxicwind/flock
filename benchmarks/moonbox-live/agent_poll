#!/usr/local/bin/python3.12
# agent_poll — collaborative agent polling system
# Uses only pre-installed packages: requests, httpx, websockets, asyncio

import os, sys, json, time, pathlib, asyncio, subprocess, socket

CHAT_DIR = pathlib.Path("/mnt/agents/.chat")
SWARM_DIR = CHAT_DIR / "swarm_workspace"
HEARTBEAT_DIR = SWARM_DIR / "heartbeats"
INBOX_DIR = CHAT_DIR / "inbox"

for d in [SWARM_DIR, HEARTBEAT_DIR, INBOX_DIR]:
    d.mkdir(parents=True, exist_ok=True)

MY_ID = "fyksdwD"
MY_RID = "19ff92f5-f992-8997-8000-09510a9a3c46"
CID = socket.gethostname()

def log(msg):
    ts = time.strftime("%Y%m%d_%H%M%S", time.gmtime())
    print(f"[{ts}] {msg}", flush=True)

def send_heartbeat(status="ACTIVE", task="", progress=""):
    hb = {
        "agent_id": MY_ID,
        "rid": MY_RID,
        "container": CID,
        "pid": os.getpid(),
        "timestamp": int(time.time()),
        "status": status,
        "task": task,
        "progress": progress,
        "capabilities": ["python3.12", "git", "network", "coordination"]
    }
    hb_file = HEARTBEAT_DIR / f"{MY_ID}.json"
    with open(hb_file, "w") as f:
        json.dump(hb, f, indent=2)
    log(f"HEARTBEAT: {status} | {task}")

def poll_agents():
    log("POLL_START")
    agents = {}
    for f in HEARTBEAT_DIR.glob("*.json"):
        try:
            with open(f) as fh:
                data = json.load(fh)
            age = int(time.time()) - data.get("timestamp", 0)
            if age < 300:  # 5 min timeout
                agents[data.get("agent_id", "unknown")] = {
                    "status": data.get("status", "?"),
                    "task": data.get("task", "?"),
                    "age": age,
                    "rid": data.get("rid", "?")
                }
        except:
            pass
    log(f"AGENTS_FOUND: {len(agents)}")
    for aid, info in agents.items():
        log(f"  {aid}: {info['status']} | {info['task']} | age={info['age']}s")
    return agents

def send_msg(to_agent, subject, body, priority="NORMAL"):
    inbox = INBOX_DIR / to_agent
    inbox.mkdir(parents=True, exist_ok=True)
    msg = {
        "from": MY_ID,
        "to": to_agent,
        "rid": MY_RID,
        "timestamp": int(time.time()),
        "priority": priority,
        "subject": subject,
        "body": body
    }
    msg_file = inbox / f"{int(time.time())}_{MY_ID}_{subject[:20]}.json"
    with open(msg_file, "w") as f:
        json.dump(msg, f, indent=2)
    log(f"MSG_SENT: {to_agent} | {subject}")

def check_my_inbox():
    my_inbox = INBOX_DIR / MY_ID
    if not my_inbox.exists():
        return []
    msgs = []
    for f in sorted(my_inbox.glob("*.json")):
        try:
            with open(f) as fh:
                data = json.load(fh)
            msgs.append(data)
            f.unlink()  # consume message
        except:
            pass
    log(f"INBOX: {len(msgs)} messages")
    for m in msgs:
        log(f"  FROM:{m.get('from','?')} | {m.get('subject','?')} | {m.get('body','?')[:100]}")
    return msgs

def main():
    if len(sys.argv) < 2:
        print("Usage: agent_poll <heartbeat|poll|msg <to> <subject> <body>|inbox>")
        sys.exit(1)
    
    cmd = sys.argv[1]
    if cmd == "heartbeat":
        send_heartbeat(sys.argv[2] if len(sys.argv) > 2 else "ACTIVE",
                       sys.argv[3] if len(sys.argv) > 3 else "",
                       sys.argv[4] if len(sys.argv) > 4 else "")
    elif cmd == "poll":
        poll_agents()
    elif cmd == "msg":
        send_msg(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "")
    elif cmd == "inbox":
        check_my_inbox()
    elif cmd == "loop":
        # Continuous poll loop
        while True:
            send_heartbeat("ACTIVE", "polling_loop", "")
            poll_agents()
            check_my_inbox()
            time.sleep(30)

if __name__ == "__main__":
    main()
