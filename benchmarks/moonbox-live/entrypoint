#!/bin/bash
# entrypoint - called on every shell start
# Sources autoloader, sets up env, ensures persistence

# Source autoloader if available
if [ -f /mnt/agents/dot/bin/autoloader ]; then
    source /mnt/agents/dot/bin/autoloader
fi

# Ensure _git exists in current dir if we're in /mnt/agents subtree
if [[ "$PWD" =~ ^/mnt/agents ]]; then
    if [ ! -d "_git" ]; then
        _git init 2>/dev/null || true
    fi
fi

# Ensure dot dirs exist
for d in bin lib venv log var etc run share tmp; do
    [ -d "/mnt/agents/dot/$d" ] || mkdir -p "/mnt/agents/dot/$d"
done

# Log entry
echo "[entrypoint] $(date -u +%Y-%m-%dT%H:%M:%SZ) uid=$(id -u) pwd=$PWD" >> /mnt/agents/dot/log/entrypoint.log

# Return clean
return 0 2>/dev/null || exit 0
